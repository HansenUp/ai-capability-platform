{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Platform Isolated Candidate",
  "version": "0.0.0",
  "identifier": "local.ai-platform.isolated-candidate",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "security": {
      "capabilities": [
        "main-candidate"
      ],
      "csp": "default-src 'self'; script-src 'self'; object-src 'none'; frame-src 'none'; connect-src 'none'"
    }
  },
  "bundle": {
    "active": false
  }
}
