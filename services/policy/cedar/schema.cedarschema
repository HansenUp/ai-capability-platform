// Cedar 实体与动作 Schema。实体属性来自身份中心（Keycloak 验签令牌）与能力目录（能力网关）。
// cedar-engine 加载策略时按本 Schema 严格校验（ValidationMode::Strict），校验不通过的策略不会生效；
// 每条判定请求的实体与 context 也按本 Schema 校验，不合规的请求一律 deny（失败关闭）。

// 人类用户：租户、角色集合（取自验签令牌），部门可选（为按部门授权预留）
entity User = { tenant: String, roles: Set<String>, department?: String };
// Agent 主体：OBO 场景中 act 声明对应的代理者，owner 为其归属人
entity Agent = { tenant: String, owner?: String };
// 能力：所属系统、风险级别（read / write_low / write_high）、数据分级、租户（属性取自能力目录）
entity Capability = { system: String, risk_level: String, data_class: String, tenant: String };
// Skill 版本（S9）：所属租户、清单声明的风险级别、提交人（属性取自能力网关的 Skill 商店）
entity Skill = { tenant: String, risk_level: String, submitter: User };

// 代理执行的 Agent（act）：id、版本与所属租户
type AgentRef = { id: String, version?: String, tenant: String };
// 判定上下文：approved 为审批状态，taint 为本次 Run 的数据污点集合，agent 为代理执行的 Agent
type AuthzContext = { approved: Bool, taint: Set<String>, agent?: AgentRef };

// invoke：调用一个能力
action invoke appliesTo { principal: [User, Agent], resource: [Capability], context: AuthzContext };
// read_data：读取能力返回的数据（为数据分级 / 脱敏规则预留）
action read_data appliesTo { principal: [User, Agent], resource: [Capability], context: AuthzContext };
// approve：审批一次高风险调用（为 S11 审批人指派与收件箱预留，当前无 permit，默认拒绝）
action approve appliesTo { principal: [User], resource: [Capability], context: AuthzContext };
// approve_skill：审批 Skill 上架（S9，双人审批：审批人必须是 skill-reviewer 且不是提交人）
action approve_skill appliesTo { principal: [User], resource: [Skill], context: AuthzContext };
