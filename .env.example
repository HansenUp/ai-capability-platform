# =============================================================================
# 本机开发环境变量模板（ai-capability-platform）
#
# 用法：
#   1. 复制为 .env：  cp .env.example .env
#   2. 只在本机 .env 中填写真实密钥；.env 不得入库（应在 .gitignore 中忽略），
#      本文件 .env.example 只放占位符，不写任何真实密钥。
#   3. 让变量生效（Makefile 不会自动读取 .env）：
#        set -a; source .env; set +a                     # 供 make run-* 启动的服务使用
#        docker compose --env-file .env -f deploy/compose-dev/docker-compose.yml up -d
#      说明：compose 文件位于 deploy/compose-dev/，默认只读取该目录或当前 shell 里的变量，
#      因此需要显式传 --env-file，或先在 shell 里 export。
#   4. 生产环境不使用 .env：密钥由 Vault 注入，环境变量只保留非敏感项。
#
# 配置优先级（Runtime）：数据库配置 > 环境变量 > 代码默认值。
# 标注"可选"的变量已被注释，需要时去掉行首 # 再填写；未设置时使用代码默认值。
# =============================================================================


# -----------------------------------------------------------------------------
# 一、模型 API 密钥（由 LiteLLM 读取，见 services/model-gateway/config.yaml）
#     真实密钥只放本机 .env。compose 通过 ${VAR:-} 从宿主机环境读取，未设置则为空。
# -----------------------------------------------------------------------------

# Anthropic 密钥：别名 default-chat 与 claude-sonnet-2026-06 使用（compose 已引用）
ANTHROPIC_API_KEY=请替换为你的-Anthropic-密钥

# DeepSeek 密钥：别名 deepseek-v4-pro-2026-08 使用，同时是 default-chat 的回退模型（compose 已引用）
DEEPSEEK_API_KEY=请替换为你的-DeepSeek-密钥

# OpenAI 密钥：向量化别名 embed-default（text-embedding-3-large）使用，知识检索场景才需要
# 注意：compose 当前未把该变量传给 litellm 容器，需要时在 docker-compose.yml 的 litellm.environment 中补充
OPENAI_API_KEY=请替换为你的-OpenAI-密钥

# Cohere 密钥：重排别名 rerank-default（rerank-v3.5）使用，知识检索场景才需要
# 注意：同上，compose 当前未传递该变量
COHERE_API_KEY=请替换为你的-Cohere-密钥


# -----------------------------------------------------------------------------
# 二、LiteLLM 模型网关自身配置（config.yaml 中以 os.environ/ 引用）
#     注意：compose 里这三项目前写死为开发默认值（见 docker-compose.yml 的 litellm 段），
#     下列值仅在不通过 compose、单独运行 LiteLLM 时使用；两边保持一致可避免混淆。
# -----------------------------------------------------------------------------

# LiteLLM 管理密钥：管理接口与签发虚拟 Key 用；业务侧使用虚拟 Key，不直接使用它
LITELLM_MASTER_KEY=sk-请替换为本机随机生成的管理密钥

# LiteLLM 自用库连接串（PostgreSQL）：存放虚拟 Key、预算与 spend 表
# compose 内的 litellm-db 服务未映射宿主机端口，容器内主机名为 litellm-db
LITELLM_DATABASE_URL=postgresql://USER:PASSWORD@litellm-db:5432/litellm

# Redis 主机：LiteLLM 响应缓存使用（端口固定 6379）；compose 内为服务名 redis，宿主机访问用 localhost
REDIS_HOST=redis


# -----------------------------------------------------------------------------
# 三、Runtime 服务（services/runtime，默认端口 8080；读取见 runtime/config.py）
# -----------------------------------------------------------------------------

# 引擎数据库连接串；默认 SQLite，接入 compose 的 MySQL 时改为下面注释中的形式
DATABASE_URL=sqlite+aiosqlite:///./runtime.db
# DATABASE_URL=mysql+asyncmy://USER:PASSWORD@localhost:3306/ai_platform

# Harness 类型：mock（CI 与无模型调试）/ claude-sdk / stdio
HARNESS=mock

# 模型网关（LiteLLM Proxy）地址
MODEL_GATEWAY_URL=http://localhost:4000

# 能力网关地址；不可达时回退到本地工具表
CAPABILITY_GATEWAY_URL=http://localhost:8082

# 策略服务（Cedar）地址；不可达时回退到内置基线规则（仅限开发）
POLICY_URL=http://localhost:8083

# 工具结果超过该 token 数就外置到工作区，只回传 artifact:// 引用
TOOL_RESULT_OFFLOAD_TOKENS=8000

# 出网白名单，逗号分隔，例如：api.anthropic.com,localhost；空表示无额外放行
EGRESS_ALLOWLIST=

# 是否强制 JWT 验签。开发期 false（使用 X-AI-Subject 头表示身份）；
# 为 true 时需同时配置 JWKS_URL（S2 工作包前返回 501）
AUTH_REQUIRED=false

# JWKS 地址（可选）：本机 Keycloak 的证书端点，宿主机端口为 8180（realm 名 ai-platform）
# JWKS_URL=http://localhost:8180/realms/ai-platform/protocol/openid-connect/certs

# 部署拓扑：central / hybrid / standalone
TOPOLOGY=central

# 节点标识，多节点本机演练时每个节点取不同值
NODE_ID=node-local

# Run 工作区根目录（可选，默认 ./runtime-workspace）
# WORKSPACE_DIR=./runtime-workspace

# stdio Harness 子进程命令（仅 HARNESS=stdio 时需要）。示例为仓库自带的回显 Harness
# HARNESS_STDIO_CMD=python -m ai_harness_stdio.echo_harness
# HARNESS_STDIO_NAME=stdio


# -----------------------------------------------------------------------------
# 四、能力网关（services/capability-gateway，默认端口 8082）
# -----------------------------------------------------------------------------

# Keycloak 令牌端点：Token Exchange（OBO）使用；未配置时令牌交换不可用
# KEYCLOAK_TOKEN_URL=http://localhost:8180/realms/ai-platform/protocol/openid-connect/token

# 网关在 Keycloak 中的 Client 标识（realm-export.json 中已定义，默认即此值）
GATEWAY_CLIENT_ID=capability-gateway

# 网关 Client 的密钥：本机从 Keycloak 管理台查看后填入，不入库
GATEWAY_CLIENT_SECRET=请替换为-capability-gateway-客户端密钥

# 核心工具预载上限，超出部分靠第二级发现（search_capabilities）
CORE_TOOL_LIMIT=20


# -----------------------------------------------------------------------------
# 五、Console API（services/console-api，默认端口 8081）
# -----------------------------------------------------------------------------

# Runtime 管理接口地址
RUNTIME_ADMIN_URL=http://localhost:8080

# 节点心跳超时秒数，超过则从路由表 /routing 剔除
HEARTBEAT_TIMEOUT_S=90


# -----------------------------------------------------------------------------
# 六、观测（Langfuse + OTel，需要 compose 的 observe profile）
#     启动：docker compose --env-file .env -f deploy/compose-dev/docker-compose.yml --profile observe up -d
#     先在 Langfuse（http://localhost:3000）创建组织与项目，再取项目的公钥与私钥填入下面。
# -----------------------------------------------------------------------------

# Langfuse 地址；未配置时 observe-adapter 在本地缓冲，不转发
# LANGFUSE_HOST=http://localhost:3000

# Langfuse 项目公钥 / 私钥（observe-adapter 以 Basic Auth 调用 Langfuse）
# LANGFUSE_PUBLIC_KEY=请替换为-Langfuse-项目公钥
# LANGFUSE_SECRET_KEY=请替换为-Langfuse-项目私钥


# -----------------------------------------------------------------------------
# 七、工单 MCP Server（mcp-servers/ticket）——约定项
#     依据 docs/decisions/2026-10-16-首个垂直切片场景确认.md 第 4 节。
#     该服务由 S4.2 实现，实现前这些变量尚无程序读取；先行列出便于对齐。
# -----------------------------------------------------------------------------

# 数据来源：mock（本机默认，使用虚构数据）/ http（对接业务系统只读 API）
TICKET_BACKEND=mock

# 仅 TICKET_BACKEND=http 时使用：业务系统只读 API 基地址（待业务系统负责人提供）
# TICKET_API_BASE_URL=https://请替换为工单系统只读接口地址

# 仅 TICKET_BACKEND=http 时使用：请求超时秒数
# TICKET_API_TIMEOUT_S=10
