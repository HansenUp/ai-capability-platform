# =============================================================================
# 本机开发环境变量模板（ai-capability-platform）
#
# 用法：
#   1. 复制为 .env：  cp .env.example .env
#   2. 只在本机 .env 中填写真实密钥；.env 不得入库（应在 .gitignore 中忽略），
#      本文件 .env.example 只放占位符，不写任何真实密钥。
#   3. 让变量生效（Makefile 不会自动读取 .env）：
#        set -a; source .env; set +a                     # 供 make run-* 启动的服务使用
#        docker compose --env-file .env -f deploy/compose-dev/docker-compose.yml up -d
#      说明：compose 文件位于 deploy/compose-dev/，默认只读取该目录或当前 shell 里的变量，
#      因此需要显式传 --env-file，或先在 shell 里 export。
#   4. 生产环境不使用 .env：密钥由 Vault 注入，环境变量只保留非敏感项。
#
# 配置优先级（Runtime）：数据库配置 > 环境变量 > 代码默认值。
# 标注"可选"的变量已被注释，需要时去掉行首 # 再填写；未设置时使用代码默认值。
# =============================================================================


# -----------------------------------------------------------------------------
# 一、模型 API 密钥（由 LiteLLM 读取，见 services/model-gateway/config.yaml）
#     真实密钥只放本机 .env。compose 通过 ${VAR:-} 从宿主机环境读取，未设置则为空。
# -----------------------------------------------------------------------------

# Anthropic 密钥：别名 default-chat 与 claude-sonnet-2026-06 使用（compose 已引用）
ANTHROPIC_API_KEY=请替换为你的-Anthropic-密钥

# DeepSeek 密钥：别名 deepseek-v4-pro-2026-08 使用，同时是 default-chat 的回退模型（compose 已引用）
DEEPSEEK_API_KEY=sk-5c9cfe709f4a4608b42b7a6a1131e144

# OpenAI 密钥：向量化别名 embed-default（text-embedding-3-large）使用，知识检索场景才需要
# 注意：compose 当前未把该变量传给 litellm 容器，需要时在 docker-compose.yml 的 litellm.environment 中补充
OPENAI_API_KEY=请替换为你的-OpenAI-密钥

# Cohere 密钥：重排别名 rerank-default（rerank-v3.5）使用，知识检索场景才需要
# 注意：同上，compose 当前未传递该变量
COHERE_API_KEY=请替换为你的-Cohere-密钥


# -----------------------------------------------------------------------------
# 二、LiteLLM 模型网关自身配置（config.yaml 中以 os.environ/ 引用）
#     注意：compose 里这三项目前写死为开发默认值（见 docker-compose.yml 的 litellm 段），
#     下列值仅在不通过 compose、单独运行 LiteLLM 时使用；两边保持一致可避免混淆。
# -----------------------------------------------------------------------------

# LiteLLM 管理密钥：管理接口与签发虚拟 Key 用；业务侧使用虚拟 Key，不直接使用它
LITELLM_MASTER_KEY=sk-请替换为本机随机生成的管理密钥

# LiteLLM 自用库连接串（PostgreSQL）：存放虚拟 Key、预算与 spend 表
# compose 内的 litellm-db 服务未映射宿主机端口，容器内主机名为 litellm-db
LITELLM_DATABASE_URL=postgresql://USER:PASSWORD@litellm-db:5432/litellm

# Redis 主机：LiteLLM 响应缓存使用（端口固定 6379）；compose 内为服务名 redis，宿主机访问用 localhost
REDIS_HOST=redis


# -----------------------------------------------------------------------------
# 三、Runtime 服务（services/runtime，默认端口 8080；读取见 runtime/config.py）
# -----------------------------------------------------------------------------

# 引擎数据库连接串；默认 SQLite，接入 compose 的 MySQL 时改为下面注释中的形式
# 首次启动会自动执行 Alembic 迁移（upgrade head）；手动执行 `make migrate`
DATABASE_URL=sqlite+aiosqlite:///./runtime.db
# DATABASE_URL=mysql+asyncmy://root:root@localhost:3316/ai_platform   # compose 的 MySQL 映射到宿主机 3316（3306 常被本机其他 MySQL 占用）

# Harness 类型：mock（CI 与无模型调试）/ litellm（平台持有循环，经模型网关直连任意模型，L2）/ claude-sdk / stdio
HARNESS=mock

# 调用模型网关的 Key：本机为 compose 里 LiteLLM 的开发主密钥；生产环境按 Agent 签发虚拟 Key
MODEL_GATEWAY_API_KEY=sk-dev-master

# 单次模型请求超时（秒）与可重试错误（429/5xx/网络）的最大重试次数
LLM_TIMEOUT_S=120
LLM_MAX_RETRIES=2

# claude-sdk Harness（HARNESS=claude-sdk 时生效）：SDK 子进程经模型网关的 Anthropic 兼容端点访问模型，
# 缺省分别取 MODEL_GATEWAY_URL 与 MODEL_GATEWAY_API_KEY，通常无需单独设置
# CLAUDE_SDK_BASE_URL=http://localhost:4000
# CLAUDE_SDK_AUTH_TOKEN=sk-dev-master

# 模型网关（LiteLLM Proxy）地址
MODEL_GATEWAY_URL=http://localhost:4000

# 能力网关地址；不可达时回退到本地工具表
CAPABILITY_GATEWAY_URL=http://localhost:8082

# 策略服务（Cedar）地址；不可达时回退到内置基线规则（仅限开发）
POLICY_URL=http://localhost:8083

# 工具结果超过该 token 数就外置到工作区，只回传 artifact:// 引用
TOOL_RESULT_OFFLOAD_TOKENS=8000

# 出网白名单，逗号分隔，例如：api.anthropic.com,localhost；空表示无额外放行
EGRESS_ALLOWLIST=

# 是否强制 JWT 验签。开发期 false（使用 X-AI-Subject 头表示身份）；
# 为 true 时 /v1、/admin 只接受 Bearer JWT（本地按 JWKS 验签），需同时配置下面的 JWKS_URL / JWT_ISSUER / JWT_AUDIENCE
AUTH_REQUIRED=false

# 本机 Keycloak（宿主机端口 8180，realm ai-platform）的取值。本机 realm 的开发客户端：agent-demo（应用，Client Credentials）、
# console-api（服务账号带 platform-admin，可调管理接口），客户端密钥为 <clientId>-dev-secret（仅限本机 compose）。
# JWKS_URL=http://localhost:8180/realms/ai-platform/protocol/openid-connect/certs
# JWT_ISSUER=http://localhost:8180/realms/ai-platform
# JWT_AUDIENCE=ai-runtime
# JWT_TENANT_CLAIM=tenant          # 携带租户的声明名；令牌缺该声明时 403
# JWKS_CACHE_TTL_S=300
# JWT_LEEWAY_S=30
# RUNTIME_ENV=dev                  # prod：启动时校验安全基线（强制鉴权、鉴权配置齐全、密钥不得来自明文环境变量）

# 密钥注入（S2.4）：DATABASE_URL、MODEL_GATEWAY_API_KEY、CLAUDE_SDK_AUTH_TOKEN 是密钥项，
# 解析顺序 Vault > <NAME>_FILE（挂载文件）> 环境变量 > 默认值；生产只允许前两种。
# 本机 compose 的 Vault（dev 模式）由 vault-init 写入开发网关 Key，启用方式：
# VAULT_ADDR=http://localhost:8200
# VAULT_TOKEN=dev-root
# VAULT_SECRET_PATH=ai-platform/runtime   # KV v2 路径（挂载点 VAULT_KV_MOUNT=secret）

# 部署拓扑：central / hybrid / standalone
TOPOLOGY=central

# 节点标识，多节点本机演练时每个节点取不同值
NODE_ID=node-local

# Run 工作区根目录（可选，默认 ./runtime-workspace）
# WORKSPACE_DIR=./runtime-workspace

# stdio Harness 子进程命令（仅 HARNESS=stdio 时需要）。示例为仓库自带的回显 Harness
# HARNESS_STDIO_CMD=python -m ai_harness_stdio.echo_harness
# HARNESS_STDIO_NAME=stdio


# -----------------------------------------------------------------------------
# 四、能力网关（services/capability-gateway，默认端口 8082）
# -----------------------------------------------------------------------------

# Keycloak 令牌端点：Token Exchange（OBO）使用；未配置时令牌交换不可用
# KEYCLOAK_TOKEN_URL=http://localhost:8180/realms/ai-platform/protocol/openid-connect/token

# 网关在 Keycloak 中的 Client 标识（realm-export.json 中已定义，默认即此值）
GATEWAY_CLIENT_ID=capability-gateway

# 网关 Client 的密钥：本机从 Keycloak 管理台查看后填入，不入库
GATEWAY_CLIENT_SECRET=请替换为-capability-gateway-客户端密钥

# 核心工具预载上限，超出部分靠第二级发现（search_capabilities）
CORE_TOOL_LIMIT=20


# -----------------------------------------------------------------------------
# 五、Console API（services/console-api，默认端口 8081）
# -----------------------------------------------------------------------------

# Runtime 管理接口地址
RUNTIME_ADMIN_URL=http://localhost:8080

# 节点心跳超时秒数，超过则从路由表 /routing 剔除
HEARTBEAT_TIMEOUT_S=90


# -----------------------------------------------------------------------------
# 六、观测（Langfuse + OTel，需要 compose 的 observe profile）
#     启动：docker compose --env-file .env -f deploy/compose-dev/docker-compose.yml --profile observe up -d
#     langfuse-web 首次启动时按 LANGFUSE_INIT_* 无头初始化组织 Local / 项目 ai-platform / 开发密钥对
#     （登录 http://localhost:3000：dev@local.test / devpassword1），无需手工建项目。仅本机开发，生产不用。
#     若 Langfuse 库里早已存在其他组织且未生成上述密钥，可在 UI 创建项目后把其公钥 / 私钥填入下面。
#     端到端验证：.venv/bin/python scripts/verify_langfuse_trace.py
# -----------------------------------------------------------------------------

# Runtime 导出 Trace 的 OTLP/HTTP 端点（基址，Runtime 自动拼 /v1/traces，指向 compose 的 otel-collector）；留空则不导出
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Langfuse 地址；未配置时 observe-adapter 在本地缓冲，不转发
# LANGFUSE_HOST=http://localhost:3000

# Langfuse 项目公钥 / 私钥（observe-adapter 以 Basic Auth 调用 Langfuse；同时作为 langfuse-web 无头初始化的项目密钥）。
# 不设置时 compose 默认使用开发值 pk-lf-dev / sk-lf-dev。
# LANGFUSE_PUBLIC_KEY=pk-lf-dev
# LANGFUSE_SECRET_KEY=sk-lf-dev

# otel-collector 转发 Trace 到 Langfuse OTel 端点时的 Authorization 头："Basic " + base64("公钥:私钥")。
# 默认值对应 pk-lf-dev:sk-lf-dev；覆盖上面两把密钥时须同步改这里，例如：
#   python -c "import base64;print('Basic '+base64.b64encode(b'公钥:私钥').decode())"
# LANGFUSE_OTEL_AUTH=Basic cGstbGYtZGV2OnNrLWxmLWRldg==

# langfuse-web 无头初始化的登录用户口令（仅本机开发）
# LANGFUSE_INIT_USER_PASSWORD=devpassword1


# -----------------------------------------------------------------------------
# 七、工单 MCP Server（mcp-servers/ticket）——约定项
#     依据 docs/decisions/2026-10-16-首个垂直切片场景确认.md 第 4 节。
#     该服务由 S4.2 实现，实现前这些变量尚无程序读取；先行列出便于对齐。
# -----------------------------------------------------------------------------

# 数据来源：mock（本机默认，使用虚构数据）/ http（对接业务系统只读 API）
TICKET_BACKEND=mock

# 仅 TICKET_BACKEND=http 时使用：业务系统只读 API 基地址（待业务系统负责人提供）
# TICKET_API_BASE_URL=https://请替换为工单系统只读接口地址

# 仅 TICKET_BACKEND=http 时使用：请求超时秒数
# TICKET_API_TIMEOUT_S=10

# ---- 容器出网代理（可选）----
# Docker Desktop 下容器若无法直连模型厂商，可填 Docker 内置代理；CI 或可直连环境留空。
CONTAINER_PROXY=

# ---- S3 发布与灰度、门户、反馈 ----
# Runtime → 观测适配器（反馈写 Langfuse score；只应内网可达），本机 make run-observe 起在 8084
# OBSERVE_ADAPTER_URL=http://localhost:8084
# Console 库（Alembic 管理，启动时自动迁移；与 Runtime 共用 MySQL 库时表名带 t_console_ 前缀）
# CONSOLE_DATABASE_URL=sqlite+aiosqlite:///./console.db
# CONSOLE_DATABASE_URL=mysql+asyncmy://root:root@localhost:3316/ai_platform
# Console 同步 Runtime 时以 Client Credentials 取令牌（Runtime 强制鉴权时需要）；未配置则用开发态身份头
# RUNTIME_ADMIN_URL=http://localhost:8080
# CONSOLE_OIDC_TOKEN_URL=http://localhost:8180/realms/ai-platform/protocol/openid-connect/token
# CONSOLE_CLIENT_ID=console-api
# CONSOLE_CLIENT_SECRET=                  # 本机 realm 为 console-api-dev-secret
# 门户（apps/portal-web，Vite 环境变量）：VITE_OIDC_ISSUER、VITE_OIDC_CLIENT_ID（缺省为本机 Keycloak 与 portal-web）

# ---- S9 Skill 商店与安全管控（按服务分别注入；以下均为可选示例）----
# 网关存储：开发可用 fs，生产必须 s3；endpoint 不含 scheme，TLS 由 SECURE 控制。
# SKILL_STORE=s3
# SKILL_FS_DIR=./.dev/skill-store
# SKILL_S3_ENDPOINT=127.0.0.1:9000
# SKILL_S3_BUCKET=ai-skills
# SKILL_S3_SECURE=false
# SKILL_S3_ACCESS_KEY=                   # 生产由密钥管理系统注入
# SKILL_S3_SECRET_KEY=                   # 生产由密钥管理系统注入
# 网关 ES256 签名私钥（PEM）；Runtime 仅接收对应公钥 JWKS，不共享私钥。
# SKILL_SIGNING_KEY_FILE=/absolute/path/to/skill-signing.pem
# SKILL_TRUST_KEYS_FILE=/absolute/path/to/skill-trust-keys.json
# SKILLS_DIR=./.dev/runtime-skills
# SKILL_EVAL_MIN_PASS_RATE=0.8           # 网关与 Console 取包内阈值和平台阈值中较高者
# SKILL_EVAL_MIN_CASES=10                # 网关复核条数下限
# SKILL_EVAL_MIN_ITEMS=10                # Console 回放条数下限
# SKILL_EVAL_MODEL_ALIAS=default-chat
# 评测临时 Agent 继承 Skill 清单数据等级；confidential 须选择矩阵准许的模型别名。
# SKILL_EVAL_HARNESS=litellm
# SKILL_EVAL_TRUSTED_CALLERS=console-api # 网关仅接受专用评测服务回写；不得加入普通 Runtime 客户端
# SKILL_EVAL_INGEST_TIMEOUT_S=60         # Console 等待 Langfuse Trace / 评分 / 运行项入库的上限
# SKILL_URL_ALLOWLIST=docs.example.com   # 包正文允许引用的 URL 主机；精确匹配
# SKILL_REVOCATION_TTL_S=30
# SKILL_REVOCATION_MAX_STALE_S=300       # 吊销列表刷新失败超过上限即失败关闭
# 数据矩阵供 Runtime 与网关共用；生产须提供带签署字段的矩阵。
# DATA_CLASS_MATRIX_FILE=/absolute/path/to/data-class-matrix.json
# THINKING_SUMMARY_MODEL_ALIAS=summary-fast-2026-10
# PARALLEL_TOOL_MAX=4                    # 快照还须显式开启 parallel_tool_calls
# Docker L1 只执行已签名清单中的固定脚本；disabled 一律拒绝执行。
# SANDBOX_BACKEND=docker
# SANDBOX_IMAGE=python@sha256:a6e34c598f2467ed0e9a8d349809fcd8b5c603269512df273a0bb1784edc11b1
# SANDBOX_TIMEOUT_S=30
# SANDBOX_MEMORY=128m
# SANDBOX_PIDS_LIMIT=64
# SANDBOX_MAX_CONCURRENCY=1
# SANDBOX_EGRESS_PROXY=                 # full-access 必配；所有写脚本还必须持久审批、写前登记，未知结果禁止 retry
# 故障接管 Worker 须共享 Docker 引擎和同路径持久工作区；配置／引擎漂移时失败关闭。
# 节点主动访问 Console；未配置 CONSOLE_URL 时节点代理不启动。
# CONSOLE_URL=http://localhost:8081
# NODE_TOKEN_URL=http://localhost:8180/realms/ai-platform/protocol/openid-connect/token
# NODE_CLIENT_ID=ai-node-svc
# NODE_CLIENT_SECRET_FILE=/absolute/path/to/node-client-secret
# NODE_POLL_INTERVAL_S=30
# RUNTIME_ADMIN_ENABLED=false           # 隐藏管理路由；对话 API 仍提供服务
# Console 校验节点令牌，受众须为 console-api；普通用户令牌不可用于节点接口。
# CONSOLE_NODE_JWKS_URL=http://localhost:8180/realms/ai-platform/protocol/openid-connect/certs
# CONSOLE_NODE_ISSUER=http://localhost:8180/realms/ai-platform
# CONSOLE_NODE_AUDIENCE=console-api
# CONSOLE_NODE_CLIENT_IDS=ai-node-svc

# S10.4 独立只读路由服务：/internal/routing 不接受开发角色头或节点令牌。
# JWT 须含 client_id=ai-routing-svc、scope=routing:read 和签名 tenant，单凭据只读单租户。
# CONSOLE_ROUTING_JWKS_URL=http://localhost:8180/realms/ai-platform/protocol/openid-connect/certs
# CONSOLE_ROUTING_ISSUER=http://localhost:8180/realms/ai-platform
# CONSOLE_ROUTING_AUDIENCE=console-routing
